{
  "name": "dataai-desktop",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "description": "DataAI TypeScript desktop — quick query templates",
  "author": "codeyG",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:servers": "vitest run src/main/live-drivers.test.ts",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --publish never",
    "dist:win": "npm run build && electron-builder --win portable nsis --publish never",
    "pack:tip": "npm run dist:win:portable",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never",
    "pack:tip:linux": "npm run dist:linux"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@tanstack/react-virtual": "^3.14.20",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "monaco-editor": "^0.57.0",
    "mssql": "^12.7.9",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
